rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      // Look up staff role; return null if document doesn't exist to avoid rule failure
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }

    // 1. Staff Collection: Staff can read/write their own profile
    match /staff/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isSignedIn();  // Any authenticated user can view staff list (for doctor selection, etc.)
      allow write: if request.auth != null && request.auth.uid == userId;  // Staff can edit own profile
      allow write: if isSignedIn() && getRole() == 'admin';  // Admin can edit any staff
    }

    // 2. Patients & Sub-collections
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getRole() in ['admin', 'doctor', 'nurse'];
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && getRole() in ['admin', 'doctor', 'nurse'];
      }
    }

    // 3. Lab Results
    match /labResults/{resultId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getRole() in ['admin', 'doctor', 'nurse'];
    }

    // 4. Pharmacy/Prescriptions
    match /allPrescriptions/{rxId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getRole() in ['admin', 'doctor'];
    }

    // 5. Appointments
    match /appointments/{apptId} {
      allow read, write: if isSignedIn();
    }

    // 6. Billing: Clinical staff can manage billing records
    match /billing/{billId} {
      allow read: if isSignedIn() && getRole() in ['admin', 'staff', 'doctor', 'nurse'];
      allow write: if isSignedIn() && getRole() in ['admin', 'staff', 'doctor', 'nurse'];
    }
  }
}
