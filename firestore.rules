rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── Staff: authenticated only ──
    match /staff/{id} {
      allow read, write: if signedIn();
    }

    // FIX-v2: Patients — public write (ID = normalized phone), staff read
    match /patients/{patientId} {
      allow write: if true;
      allow read: if signedIn();
      allow delete: if signedIn();
    }

    // ── Patient Examinations (subcollection) ──
    // Required for automatic exam note creation during appointment completion
    match /patients/{patientId}/examinations/{examId} {
      allow read, write: if signedIn();
    }

    // ── Appointments: public create only (atomic slot lock) ──
    // Document ID = {doctorId}_{YYYYMMDD}_{HHMM}
    // setDoc(ref, data) without merge on existing doc = update → DENIED
    // Double booking is prevented by Firestore "create-only" enforcement
    match /appointments/{slotId} {
      allow create: if true;
      allow read: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    // ── Secure Appointments: public create (with schema validation), public read ──
    // Document ID = random 48-char hex token
    // No listing allowed — prevents enumeration
    // Schema validation: must have appointmentId as string to prevent spam
    match /secureAppointments/{token} {
      allow create: if true;
      allow read: if true;
      allow update: if signedIn();
      allow write: if signedIn();
      allow list: if false;
    }

    // ── Billing: authenticated staff only ──
    match /billing/{billId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ── Lab Results: authenticated staff only ──
    match /labResults/{resultId} {
      allow read, write: if signedIn();
    }

    // ── Prescriptions: authenticated staff only ──
    match /allPrescriptions/{rxId} {
      allow read, write: if signedIn();
    }
  }
}